{
  "name": "clankerlog",
  "version": "0.23.0",
  "description": "CLI entrypoint for privacy-friendly ClankerLog coding-agent activity clanks.",
  "keywords": [
    "activity-log",
    "clankerlog",
    "clanks",
    "coding-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kodi/clankerlog-cli"
  },
  "bin": {
    "clankerlog": "./bin/clankerlog.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./bin/clankerlog.js",
  "scripts": {
    "build": "tsdown",
    "postbuild": "chmod +x bin/clankerlog.js",
    "check": "mise run check",
    "dev": "tsx src/cli.ts",
    "format": "oxfmt . --write",
    "format-check": "oxfmt . --check",
    "lint": "oxlint src --deny-warnings",
    "lint-fix": "oxlint src --fix",
    "prepack": "mise run build",
    "prepublishOnly": "mise run check",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "fetch-safe": "^0.2.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "@typescript/native-preview": "7.0.0-dev.20260517.1",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "tsdown": "0.22.0",
    "tsx": "^4.22.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.0.8"
}
